{
  "name": "personalive-desktop",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npx tsx --test src/utils/faceMath.test.ts src/utils/faceMesh.test.ts src/utils/neuralPipelineAudit.test.ts src/utils/assetUrl.test.ts src/utils/imageStatistics.test.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop:run": "electron .",
    "desktop:dev": "node electron/dev.cjs",
    "desktop:build": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "description": "PersonaLive Desktop Studio - real-time face transformation with on-device 478-point tracking",
  "main": "electron/main.cjs",
  "build": {
    "appId": "ai.personalive.desktop",
    "productName": "PersonaLive Desktop Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/pwa-512x512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github"
    }
  }
}
